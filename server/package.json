{
  "name": "blankets-api",
  "private": true,
  "version": "0.1.0",
  "description": "Backend API for the blankets e-commerce site (quotes, auth, Airtable proxy, email threading).",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "create-admin": "node scripts/create-admin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "dependencies": {
    "airtable": "^0.12.2",
    "bcryptjs": "^2.4.3",
    "connect-session-knex": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "imapflow": "^1.0.0",
    "knex": "^3.1.0",
    "mailparser": "^3.7.0",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3"
  }
}

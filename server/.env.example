# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with credentials
FRONTEND_ORIGINS=http://localhost:5173

# MySQL (HostKing-hosted)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sessions
# Long random string, e.g. `openssl rand -hex 32`. Rotating this logs everyone out.
SESSION_SECRET=


# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with credentials
FRONTEND_ORIGINS=http://localhost:5173

# MySQL (HostKing-hosted)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sessions
# Long random string, e.g. `openssl rand -hex 32`. Rotating this logs everyone out.
SESSION_SECRET=

# Airtable (product catalogue + thread colours)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# File uploads — outside the web root on HostKing. Defaults to server/uploads/
# if unset.
# UPLOADS_DIR=

# SMTP (sending) — the domain mailbox's outgoing mail server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# IMAP (receiving) — usually the same mailbox as SMTP
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Where new-quote / new-reply notification emails are sent. Defaults to
# SMTP_USER if unset.
# COMPANY_NOTIFICATION_EMAIL=

# Domain used to construct outbound Message-IDs. Defaults to SMTP_USER's
# domain if unset.
# MAIL_DOMAIN=

# Folder incoming mail is moved to after being matched and logged.
# IMAP_PROCESSED_FOLDER=App-Processed

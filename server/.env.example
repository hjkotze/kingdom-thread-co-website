# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with credentials
FRONTEND_ORIGINS=http://localhost:5173
# Canonical URL used to build links in outbound emails (e.g. email
# verification). Defaults to the first FRONTEND_ORIGINS entry if unset.
# FRONTEND_URL=http://localhost:5173
# Dev only: also allow any origin on this LAN subnet (e.g. testing from a
# phone/tablet on the same network) without listing each device IP in
# FRONTEND_ORIGINS. Leave unset outside local development.
# FRONTEND_LAN_SUBNET=192.168.2

# MySQL (HostKing-hosted)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sessions
# Long random string, e.g. `openssl rand -hex 32`. Rotating this logs everyone out.
SESSION_SECRET=

# Airtable (product catalogue + thread colours) — replaced by NocoDB below
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# NocoDB (self-hosted, replaces Airtable — product catalogue + thread colours)
# Root URL of the NocoDB instance, e.g. https://nocodb.example.com
NOCODB_BASE_URL=
# API token, generated in NocoDB under Account Settings > API Tokens
NOCODB_API_TOKEN=
# Base (project) ID, e.g. from /api/v2/meta/bases in the NocoDB API
NOCODB_BASE_ID=

# File uploads — outside the web root on HostKing. Defaults to server/uploads/
# if unset.
# UPLOADS_DIR=

# SMTP (sending) — the domain mailbox's outgoing mail server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# IMAP (receiving) — usually the same mailbox as SMTP
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Where new-quote / new-reply notification emails are sent. Defaults to
# SMTP_USER if unset.
# COMPANY_NOTIFICATION_EMAIL=

# Domain used to construct outbound Message-IDs. Defaults to SMTP_USER's
# domain if unset.
# MAIL_DOMAIN=

# Folder incoming mail is moved to after being matched and logged.
# IMAP_PROCESSED_FOLDER=App-Processed

# First-deploy only: if set AND no admin account exists yet, an admin is
# created automatically the first time the server boots. Once any admin
# exists (this way or via `npm run create-admin`), these are permanently
# ignored — safe to leave set, but recommended to remove them after first
# login as a precaution.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_NAME=Admin
